OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional — leave both empty for local dev (direct OpenSky access works
# fine). Needed only when the backend's own outbound network can't reach
# opensky-network.org (observed on Render's free tier) — see
# cloudflare-relay/worker.js.
OPENSKY_RELAY_URL=
OPENSKY_RELAY_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
