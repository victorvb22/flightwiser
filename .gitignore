# Secrets
.env
*.env
!.env.example

# Raw / regenerable data
data/raw/
data/processed/
# data/reference/ itself is NOT ignored (unlike data/raw/, data/processed/
# above) — only the large raw downloads within it are. A directory-level
# ignore (`data/reference/`) would have blocked git from ever descending
# into it, making a `!`-negation for a specific file inside it a no-op —
# git's own documented limitation, not a typo. The two *_trimmed.parquet
# files ARE meant to be committed: pre-processed snapshots bundled with the
# deploy (services/aircraft_database.py, services/airports.py) — production
# reads these instead of fetching ~94 Mo live from a third party as part of
# serving a request (observed failing outright on Render: connection
# timeout to opensky-network.org). Regenerate with
# scripts/generate_reference_snapshots.py when the upstream source changes.
data/reference/*.csv

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Editors / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
